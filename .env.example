# ==============================================================================
# NARA APP — Environment Variables
# ==============================================================================

# Supabase (Tier Gratis)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Secret Key (Untuk mengamankan API generate kode lisensi)
ADMIN_SECRET_KEY=nara-admin-secret-2026

# Session Secret (Untuk signing / validasi custom session)
SESSION_SECRET=nara-session-secret-key-super-secure
